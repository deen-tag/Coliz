// Coliz V2 — schéma de base de données
// Stack retenue : PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// UTILISATEURS & VÉRIFICATION
// ─────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
  MODERATOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  emailVerifiedAt   DateTime?
  phone             String?
  phoneVerifiedAt   DateTime?
  passwordHash      String
  firstName         String
  lastName          String
  avatarUrl         String?
  bio               String?
  role              UserRole      @default(USER)
  status            AccountStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Vérification d'identité (distincte de email/phone — cf. badge "Profil vérifié")
  identityVerifiedAt DateTime?
  identityVerificationId String?  // référence à la session Stripe Identity

  // Préférences — écran Paramètres
  notifyEmail        Boolean      @default(true)
  notifyPush         Boolean      @default(true)
  language           String       @default("fr")

  // Stripe Connect (rôle voyageur = compte connecté)
  stripeCustomerId   String?      // pour payer en tant qu'expéditeur
  stripeConnectedAccount StripeConnectedAccount?

  // Réputation
  ratingAverage      Float        @default(0)
  ratingCount        Int          @default(0)

  parcelsAsSender    Parcel[]     @relation("SenderParcels")
  trips              Trip[]
  bookingsAsSender   Booking[]    @relation("SenderBookings")
  bookingsAsTraveler Booking[]    @relation("TravelerBookings")
  reviewsWritten     Review[]     @relation("ReviewAuthor")
  reviewsReceived    Review[]     @relation("ReviewTarget")
  notifications      Notification[]
  messages           Message[]
  incidents          Incident[]
  wallet             Wallet?
  adminAuditLogs     AdminAuditLog[]

  @@index([email])
}

// Vérification granulaire — jamais fusionnée en un seul statut binaire
model Verification {
  id          String   @id @default(cuid())
  userId      String
  type        VerificationType
  status      VerificationStatus @default(PENDING)
  provider    String?  // ex: "stripe_identity", "twilio", "internal"
  verifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
}

enum VerificationType {
  EMAIL
  PHONE
  IDENTITY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  EXPIRED
}

// ─────────────────────────────────────────────
// COLIS
// ─────────────────────────────────────────────

enum ParcelStatus {
  DRAFT
  SEARCHING
  MATCHED
  BOOKED
  PAID
  PICKED_UP
  IN_TRANSIT
  ARRIVED
  DELIVERED
  CLOSED
  CANCELLED
}

model Parcel {
  id                String       @id @default(cuid())
  senderId          String
  sender            User         @relation("SenderParcels", fields: [senderId], references: [id])

  originLabel       String
  originLat         Float
  originLng         Float
  destinationLabel  String
  destinationLat    Float
  destinationLng    Float

  desiredDate       DateTime
  dateFlexibleDays  Int          @default(0)

  weightKg          Float
  lengthCm          Float
  widthCm           Float
  heightCm          Float
  parcelCount       Int          @default(1)
  declaredValue     Decimal      @db.Decimal(10, 2)
  photoUrl          String?

  prohibitedItemsAccepted Boolean @default(false)

  status            ParcelStatus @default(DRAFT)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bookings          Booking[]

  @@index([senderId])
  @@index([status])
}

// ─────────────────────────────────────────────
// TRAJETS
// ─────────────────────────────────────────────

enum TransportMode {
  CAR
  TRAIN
  BUS
  PLANE
  MOTORCYCLE
  BICYCLE
  VAN
  FERRY
  OTHER
}

enum TripStatus {
  DRAFT
  PUBLISHED
  PARTIALLY_BOOKED
  FULLY_BOOKED
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  CANCELLED
}

model Trip {
  id                String       @id @default(cuid())
  travelerId        String
  traveler          User         @relation(fields: [travelerId], references: [id])

  originLabel       String
  originLat         Float
  originLng         Float
  destinationLabel  String
  destinationLat    Float
  destinationLng    Float

  departureAt       DateTime
  arrivalAt         DateTime?

  mode              TransportMode

  // Contrainte cotransportage : le trajet doit préexister au colis (mode CAR uniquement)
  preexistingJourneyConfirmed Boolean @default(false)

  capacityWeightKg  Float
  capacityLengthCm  Float
  capacityWidthCm   Float
  capacityHeightCm  Float
  capacityParcels   Int          @default(1)
  remainingParcels  Int          @default(1)

  pickupPointLabel  String?
  dropoffPointLabel String?

  contributionAmount Decimal     @db.Decimal(10, 2) // proposée ou calculée

  status            TripStatus   @default(DRAFT)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  bookings          Booking[]

  @@index([travelerId])
  @@index([status])
  @@index([departureAt])
}

// Règles par mode de transport, configurables en admin (section 10 du cahier des charges)
model TransportModeRule {
  id            String        @id @default(cuid())
  mode          TransportMode @unique
  enabled       Boolean       @default(true)
  legalRegime   String?       // description du régime applicable (cotransportage, transporteur classique, etc.)
  restrictionsText String?    // affiché au moment pertinent dans le parcours de création de trajet
  updatedAt     DateTime      @updatedAt
}

// Limites commerciales globales configurables en admin (section 6)
model ParcelRuleSettings {
  id                 String   @id @default("singleton")
  maxWeightKg        Float
  maxLengthCm        Float
  maxWidthCm         Float
  maxHeightCm        Float
  maxDeclaredValue   Decimal  @db.Decimal(10, 2)
  prohibitedItemsText String
  updatedAt          DateTime @updatedAt
}

// ─────────────────────────────────────────────
// RÉSERVATION & PAIEMENT (Stripe Connect)
// ─────────────────────────────────────────────

enum BookingStatus {
  REQUESTED
  ACCEPTED
  PAYMENT_PENDING
  CONFIRMED        // payé — les 2 codes (remise/réception) sont générés à cet instant
  PICKED_UP        // code de remise vérifié par le voyageur
  DELIVERED        // code de réception vérifié par le voyageur
  DELIVERY_FAILED  // réceptionniste injoignable/absent — colis reste chez le voyageur
  COMPLETED        // livraison confirmée + rémunération versée au voyageur
  CANCELLED
  INCIDENT

  // Conservé temporairement pour compatibilité des données existantes en base
  // (anciennes réservations créées avant l'introduction des codes).
  // Ne plus utiliser dans du code neuf — supprimer après migration des données.
  IN_PROGRESS
}

model Booking {
  id              String        @id @default(cuid())
  parcelId        String
  parcel          Parcel        @relation(fields: [parcelId], references: [id])
  tripId          String
  trip            Trip          @relation(fields: [tripId], references: [id])

  senderId        String
  sender          User          @relation("SenderBookings", fields: [senderId], references: [id])
  travelerId      String
  traveler        User          @relation("TravelerBookings", fields: [travelerId], references: [id])

  contributionAmount Decimal    @db.Decimal(10, 2) // part du voyageur
  platformFeeAmount  Decimal    @db.Decimal(10, 2) // commission Coliz
  totalAmount        Decimal    @db.Decimal(10, 2) // payé par l'expéditeur

  status          BookingStatus @default(REQUESTED)
  cancellationReason String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  transactions    Transaction[]
  messages        Message[]
  reviews         Review[]
  incidents       Incident[]
  transferCodes   TransferCode[]
  events          BookingEvent[]

  @@index([senderId])
  @@index([travelerId])
  @@index([status])
}

// ─────────────────────────────────────────────
// CODES DE REMISE / RÉCEPTION
// ─────────────────────────────────────────────
// Principe : les deux codes appartiennent à l'expéditeur du début à la fin.
// Il transmet le code PICKUP au voyageur en personne au départ, et gère
// lui-même — hors app — la transmission du code DELIVERY à la personne
// qui réceptionnera à l'arrivée. Le voyageur ne détient jamais aucun code
// à l'avance et ne peut donc jamais valider seul une étape (cf. cahier des
// charges §10-11 et plan caution §3).

enum CodePurpose {
  PICKUP    // expéditeur → voyageur, au départ
  DELIVERY  // "réceptionniste" désigné par l'expéditeur → voyageur, à l'arrivée
}

enum CodeStatus {
  ACTIVE
  VERIFIED
  EXPIRED
  LOCKED   // trop de tentatives échouées, régénération requise
  REVOKED  // remplacé par une régénération
}

model TransferCode {
  id            String       @id @default(cuid())
  bookingId     String
  booking       Booking      @relation(fields: [bookingId], references: [id])
  purpose       CodePurpose
  codeCipher    String       // AES-256-GCM(code, clé serveur) — réversible uniquement côté serveur,
                              // jamais le code en clair en base ni dans un log/metadata
  status        CodeStatus   @default(ACTIVE)
  attemptsCount Int          @default(0)
  maxAttempts   Int          @default(5)
  expiresAt     DateTime
  verifiedAt    DateTime?
  verifiedById  String?      // toujours le voyageur en pratique ; tracé explicitement
  createdAt     DateTime     @default(now())

  @@index([bookingId, purpose])
}

// Journal d'événements immuable — c'est la preuve métier en cas de litige,
// pas la parole de l'expéditeur ou du voyageur.
enum BookingEventType {
  PICKUP_CODE_ISSUED
  PICKUP_CODE_ATTEMPT_FAILED
  PICKUP_CODE_VERIFIED
  DELIVERY_CODE_ISSUED
  DELIVERY_CODE_ATTEMPT_FAILED
  DELIVERY_CODE_VERIFIED
  DELIVERY_ISSUE_REPORTED
  CODE_REGENERATED
  STATUS_CHANGED
}

model BookingEvent {
  id        String           @id @default(cuid())
  bookingId String
  booking   Booking          @relation(fields: [bookingId], references: [id])
  type      BookingEventType
  actorId   String?          // null si déclenché par le système
  actorRole String           // SENDER / TRAVELER / SYSTEM / ADMIN
  metadata  Json?            // jamais le code en clair — seulement le résultat (ex: tentative n°3)
  createdAt DateTime         @default(now())

  @@index([bookingId, createdAt])
}

// Compte Stripe Connect du voyageur
model StripeConnectedAccount {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id])
  stripeAccountId     String   @unique
  onboardingCompleted Boolean  @default(false)
  chargesEnabled      Boolean  @default(false)
  payoutsEnabled      Boolean  @default(false)
  detailsSubmitted    Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum TransactionType {
  PAYMENT_INTENT
  TRANSFER_TO_TRAVELER
  PLATFORM_FEE
  REFUND
  PAYOUT
}

enum TransactionStatus {
  PENDING
  AUTHORIZED
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

// Historique complet des transactions Stripe liées à une réservation
model Transaction {
  id                String             @id @default(cuid())
  bookingId         String
  booking           Booking            @relation(fields: [bookingId], references: [id])
  type              TransactionType
  status            TransactionStatus  @default(PENDING)
  amount            Decimal            @db.Decimal(10, 2)
  currency           String            @default("eur")
  stripeObjectId     String?           // payment_intent id, transfer id, refund id...
  stripeEventId      String?           // id de l'event webhook source
  metadata           Json?
  createdAt          DateTime          @default(now())

  @@index([bookingId])
  @@index([stripeObjectId])
}

// Portefeuille voyageur — vue agrégée, alimentée par les Transaction
model Wallet {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  availableAmount Decimal  @default(0) @db.Decimal(10, 2)
  pendingAmount   Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────
// MESSAGERIE
// ─────────────────────────────────────────────

model Message {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  content     String
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([bookingId])
}

// ─────────────────────────────────────────────
// AVIS
// ─────────────────────────────────────────────

model Review {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id])
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId    String
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id])
  rating      Int      // 1-5
  comment     String?
  status      String   @default("PUBLISHED") // PUBLISHED / FLAGGED / REMOVED
  createdAt   DateTime @default(now())

  @@index([targetId])
  @@index([bookingId])
}

// ─────────────────────────────────────────────
// INCIDENTS
// ─────────────────────────────────────────────

enum IncidentStatus {
  OPEN
  IN_REVIEW
  ACTION_REQUIRED
  RESOLVED
  CLOSED
}

model Incident {
  id          String         @id @default(cuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id])
  reporterId  String
  reporter    User           @relation(fields: [reporterId], references: [id])
  category    String
  description String
  attachments Json?          // liste d'URLs
  status      IncidentStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([bookingId])
  @@index([status])
}

// ─────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────
// ADMINISTRATION
// ─────────────────────────────────────────────

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id])
  action      String
  targetType  String
  targetId    String
  details     Json?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}
